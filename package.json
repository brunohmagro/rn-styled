{
  "name": "rn-styled-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "example:start": "pnpm --filter ExampleApp start",
    "example:start:reset": "pnpm --filter ExampleApp start:reset",
    "example:android": "pnpm --filter ExampleApp android",
    "example:ios": "pnpm --filter ExampleApp ios",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "changeset": "changeset",
    "release:check": "pnpm --filter @rn-styled/core lint && pnpm --filter @rn-styled/core test && pnpm --filter @rn-styled/core build && pnpm --filter @rn-styled/styled lint && pnpm --filter @rn-styled/styled test && pnpm --filter @rn-styled/styled build && (cd packages/core && npm pack --dry-run) && (cd packages/styled && npm pack --dry-run)",
    "version-packages": "changeset version",
    "release": "pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.4.5",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.84.1",
      "react-test-renderer": "19.2.3"
    }
  }
}
